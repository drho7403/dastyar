<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingVertical="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/nd_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="17sp" android:textColor="@color/w_accent" android:fontFamily="@font/titr_bold"/>
        <TextView android:id="@+id/nd_greg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/w_sub" android:fontFamily="@font/bnazanin" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="10dp">
        <ImageView android:id="@+id/nd_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/nd_day" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="15sp" android:textColor="@color/w_accent" android:fontFamily="@font/titr_bold"/>
    </FrameLayout>
</LinearLayout>
